# Writes every file under a folder into a C++ source as byte arrays, so the
# program carries them (the default texture pack as the last fallback,
# Section 15.1). Run in script mode:
#
#   cmake -DFOLDER=<folder> -DOUTPUT=<file.cpp> -DHEADER=<include> -DNAMESPACE=<ns>
#         -DFUNCTION=<name> -P EmbedFiles.cmake
#
# The source defines `std::span<const vxe::render::EmbeddedFile> <ns>::<name>()`
# with paths relative to the folder (forward slashes), sorted.

cmake_minimum_required(VERSION 3.28)
cmake_policy(VERSION 3.28)

file(GLOB_RECURSE files RELATIVE "${FOLDER}" "${FOLDER}/*")
list(FILTER files EXCLUDE REGEX "^ui/panorama\.") # Decoration, stays a file on disk.
list(SORT files)

set(arrays "")
set(entries "")
set(index 0)
foreach(path IN LISTS files)
    file(READ "${FOLDER}/${path}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    if(hexLength EQUAL 0)
        set(bytes "0")
        set(size 0)
    else()
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        math(EXPR size "${hexLength} / 2")
    endif()
    string(APPEND arrays "constexpr std::array<unsigned char, ${size}> kFile${index} = {${bytes}};\n")
    string(APPEND entries "    {.path = \"${path}\", .bytes = kFile${index}},\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/EmbedFiles.cmake from ${FOLDER}. Do not edit.
#include \"${HEADER}\"

#include <array>

namespace {

${arrays}
constexpr std::array<vxe::render::EmbeddedFile, ${index}> kFiles = {{
${entries}}};

} // namespace

namespace ${NAMESPACE} {

std::span<const vxe::render::EmbeddedFile> ${FUNCTION}() {
    return kFiles;
}

} // namespace ${NAMESPACE}
")
# Only touch the output when it changed, so builds stay incremental.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
