{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "voxel-rethinked",
  "version": "0.1.0",
  "description": "Voxel Rethinked, a modern voxel sandbox game, and the vxe engine.",
  "builtin-baseline": "0e5030f583a5427123cd3b714255e5ae62faa3ba",
  "dependencies": [
    "doctest",
    "glm",
    {
      "name": "spdlog",
      "default-features": false
    },
    "unordered-dense",
    "xxhash",
    "lz4",
    "zstd"
  ],
  "features": {
    "profiling": {
      "description": "Tracy profiler client, used by the relwithdebinfo preset.",
      "dependencies": [
        {
          "name": "tracy",
          "features": [
            "on-demand"
          ]
        }
      ]
    }
  }
}
