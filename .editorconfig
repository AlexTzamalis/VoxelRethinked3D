# Editor settings shared by every IDE (CLion, Visual Studio, VS Code).
# Line endings are not set here on purpose: .gitattributes owns them.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
